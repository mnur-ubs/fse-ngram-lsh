# Copy this file to .env and fill in the values (Windows: copy .env.example .env).
# .env is read by config/database.php. Variables already set in the shell take precedence.
# Do not share .env: it contains your database password.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=master_icd_x
DB_USER=root
DB_PASS=

# HMAC/AES key used to build the encrypted index. Every script must use the same key that
# seed_database.php used, otherwise no trapdoor will match. Leave empty to use the built-in
# demo key from config/database.php.
FKSE_SECRET_KEY=
